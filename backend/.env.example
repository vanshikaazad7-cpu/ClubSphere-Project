# ==============================================================================
# ClubSphere Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=ClubSphere
API_V1_PREFIX=/api/v1
DEBUG=true

# Database Connection (Azure SQL / SQL Server or local SQLite for development)
# For Azure SQL in production:
# DATABASE_URL=mssql+pyodbc://username:password@clubsphere-sql.database.windows.net/clubspheredb?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# For local dev / testing:
DATABASE_URL=sqlite:///./clubsphere_dev.db

# JWT Security
# Generate secure random secret with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Azure Blob Storage (Phase 7 / Cloud Storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=clubsphere-uploads
AZURE_STORAGE_USE_EMULATOR=true
LOCAL_UPLOAD_DIR=./uploads

# Upload Limits & File Security
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
